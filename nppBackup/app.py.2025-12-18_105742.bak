import streamlit as st
import requests
import pandas as pd

# --- Helper Function: Abstract ---
def reconstruct_abstract(inverted_index):
    """Reconstructs the abstract text from OpenAlex's inverted index format."""
    if not inverted_index:
        return None
    max_index = 0
    for indices in inverted_index.values():
        max_index = max(max_index, max(indices))
    abstract_words = [""] * (max_index + 1)
    for word, indices in inverted_index.items():
        for index in indices:
            abstract_words[index] = word
    return " ".join(abstract_words)

# --- Helper Function: Get Author Details ---
def fetch_author_details(author_ids):
    """
    Takes a list of OpenAlex Author IDs (e.g., ['https://openalex.org/A123', ...])
    and fetches their Institution and Country in one batch call.
    """
    if not author_ids:
        return {}
    
    # Clean IDs to get just the "A..." part if full URL is provided
    clean_ids = [aid.split('/')[-1] for aid in author_ids]
    
    # OpenAlex allows filtering by multiple IDs separated by pipe |
    ids_param = "|".join(clean_ids)
    
    url = "https://api.openalex.org/authors"
    params = {
        "filter": f"openalex_id:{ids_param}",
        "per_page": 50
    }
    
    try:
        response = requests.get(url, params=params)
        if response.status_code == 200:
            data = response.json().get('results', [])
            details_map = {}
            for author in data:
                # Extract last known institution
                affil = author.get('last_known_institution')
                if affil:
                    inst_name = affil.get('display_name', 'Unknown')
                    country = affil.get('country_code', '')
                else:
                    inst_name = "Unknown"
                    country = ""
                
                details_map[author['id']] = {
                    "institution": inst_name,
                    "country": country
                }
            return details_map
    except:
        return {}
    return {}

# --- App Configuration ---
st.set_page_config(page_title="Development Effectiveness Search", page_icon="🌍", layout="wide")
st.title("🌍 Development Effectiveness & Aid Search")
st.markdown("Searching specifically within **International Development and Aid**.")

# --- Session State ---
if 'page' not in st.session_state:
    st.session_state['page'] = 1

# --- Input Section ---
col_controls_1, col_controls_2 = st.columns([2, 1])

with col_controls_1:
    selected_principle = st.radio(
        "Filter by Principle:",
        [
            "Country Ownership", 
            "Focus on Results", 
            "Inclusive Partnerships", 
            "Transparency and Accountability"
        ],
        horizontal=True
    )

with col_controls_2:
    st.write("") # Spacer
    st.write("") 
    is_global_south = st.checkbox("Only Global South Works", 
                                  help="Filters for institutions located in the Global South (World Bank definition).")

query = st.text_input("Enter keyword:", placeholder="e.g., Microfinance, cash transfers")

# --- Reset Logic ---
current_search_hash = f"{query}_{selected_principle}_{is_global_south}"
if 'last_search_hash' not in st.session_state:
    st.session_state['last_search_hash'] = current_search_hash

if current_search_hash != st.session_state['last_search_hash']:
    st.session_state['page'] = 1
    st.session_state['last_search_hash'] = current_search_hash

# --- Search Logic ---
if query:
    url = "https://api.openalex.org/works"
    
    combined_search = f"{query} AND \"{selected_principle}\""
    
    # Base Filter
    filter_string = "topics.id:T11168"
    if is_global_south:
        filter_string += ",institutions.is_global_south:true"
    
    # 1. API Call for PAPERS
    params_works = {
        "search": combined_search,
        "filter": filter_string,
        "sort": "cited_by_count:desc",
        "per_page": 10,
        "page": st.session_state['page'],
        "mailto": "email@email.com"  
    }

    # 2. API Call for TOP AUTHORS (Group By)
    params_authors = {
        "search": combined_search,
        "filter": filter_string,
        "group_by": "authorships.author.id",
        "mailto": "email@email.com"
    }

    st.caption(f"Page {st.session_state['page']} | Filter: `{filter_string}`")

    with st.spinner("Fetching global literature and author profiles..."):
        try:
            # --- PHASE 1: Fetch Authors (Page 1 Only) ---
            top_authors_data = []
            if st.session_state['page'] == 1:
                response_authors = requests.get(url, params=params_authors)
                
                if response_authors.status_code == 200:
                    author_groups = response_authors.json().get('group_by', [])
                    top_10_groups = author_groups[:10]
                    
                    # EXTRACT IDS for batch lookup
                    ids_to_fetch = [group['key'] for group in top_10_groups]
                    
                    # BATCH FETCH DETAILS
                    author_details_map = fetch_author_details(ids_to_fetch)
                    
                    for group in top_10_groups:
                        a_id = group['key']
                        details = author_details_map.get(a_id, {"institution": "Unknown", "country": ""})
                        
                        top_authors_data.append({
                            "Author Name": group['key_display_name'],
                            "Institution": details['institution'],
                            "Country": details['country'],
                            "Works Count": group['count']
                        })

            # --- PHASE 2: Fetch Papers ---
            response_works = requests.get(url, params=params_works)
            
            # --- UI RENDERING ---
            
            # A. Author Table
            if top_authors_data:
                st.subheader("🏆 Top 10 Authors (Matching Filters)")
                df = pd.DataFrame(top_authors_data)
                
                # Column Config for better display (flags for countries if possible, but code is safer)
                st.dataframe(
                    df, 
                    use_container_width=True, 
                    hide_index=True,
                    column_config={
                        "Works Count": st.column_config.NumberColumn(format="%d")
                    }
                )
                st.markdown("---")

            # B. Paper Results
            if response_works.status_code == 200:
                data = response_works.json()
                results = data.get('results', [])
                total_count = data['meta']['count']
                
                if not results:
                    st.warning("No results found matching all criteria.")
                else:
                    st.subheader(f"📚 Top Papers (Found {total_count})")
                    
                    for work in results:
                        # Extract Data
                        title = work.get('title') or "Untitled"
                        publication_year = work.get('publication_year')
                        cited_by = work.get('cited_by_count')
                        link = work.get('doi') or work.get('landing_page_url')
                        
                        # Source (Journal/Conference) Extraction
                        primary_loc = work.get('primary_location') or {}
                        source = primary_loc.get('source') or {}
                        source_name = source.get('display_name', 'Unknown Source')
                        
                        authorships = work.get('authorships', [])
                        author_names = [a['author']['display_name'] for a in authorships]
                        if len(author_names) > 3:
                            author_str = ", ".join(author_names[:3]) + " et al."
                        else:
                            author_str = ", ".join(author_names)

                        # Display
                        with st.container():
                            if link:
                                st.markdown(f"### [{title}]({link})")
                            else:
                                st.markdown(f"### {title}")
                            
                            # Info Row
                            c1, c2, c3, c4 = st.columns([3, 2, 1, 1])
                            with c1: st.caption(f"**Source:** {source_name}")
                            with c2: st.caption(f"✍️ {author_str}")
                            with c3: st.caption(f"📅 {publication_year}")
                            with c4: st.markdown(f"**⭐ {cited_by}**")
                            
                            abstract_text = reconstruct_abstract(work.get('abstract_inverted_index'))
                            if abstract_text:
                                st.markdown(f"<small>{abstract_text}</small>", unsafe_allow_html=True)
                            else:
                                st.caption("*No abstract available.*")
                            st.divider()

                    # --- Pagination ---
                    col_prev, col_next = st.columns([1, 1])
                    with col_prev:
                        if st.session_state['page'] > 1:
                            if st.button("⬅️ Previous"):
                                st.session_state['page'] -= 1
                                st.rerun()

                    with col_next:
                        if (st.session_state['page'] * 10) < total_count:
                            if st.button("Next ➡️"):
                                st.session_state['page'] += 1
                                st.rerun()
            else:
                st.error(f"Error fetching works: {response_works.status_code}")

        except Exception as e:
            st.error(f"Connection failed: {e}")