import streamlit as st
import requests
import pandas as pd

def reconstruct_abstract(inverted_index):
    """Reconstructs the abstract text from OpenAlex's inverted index format."""
    if not inverted_index:
        return None
    max_index = 0
    for indices in inverted_index.values():
        max_index = max(max_index, max(indices))
    abstract_words = [""] * (max_index + 1)
    for word, indices in inverted_index.items():
        for index in indices:
            abstract_words[index] = word
    return " ".join(abstract_words)

# 1. App Layout & Title
st.set_page_config(page_title="Development Effectiveness Literature Search", page_icon="🌍")
st.title("🌍 Development Effectiveness Literature Search")
st.markdown("Searching OpenAlex for the topic **International Development and Aid**.")

# 2. Radio Button Selection
selected_principle = st.radio(
    "Filter by Development Effectiveness Principle:",
    [
        "Country Ownership", 
        "Focus on Results", 
        "Inclusive Partnerships", 
        "Transparency and Accountability"
    ],
    horizontal=True
)

# 3. Input Section
query = st.text_input("Enter keyword:", placeholder="e.g., Microfinance, cash transfers")

# 4. Search Logic
if query:
    # OpenAlex API Endpoint
    url = "https://api.openalex.org/works"
    
    # Combine query + principle
    combined_search = f"{query} AND \"{selected_principle}\""
    
    # --- Standard Params for fetching Papers ---
    params_works = {
        "search": combined_search,
        "filter": "topics.id:T11168",
        "sort": "cited_by_count:desc",
        "per_page": 10, 
        "mailto": "email@email.com"  
    }

    # --- New Params for fetching Top Authors (Group By) ---
    # We copy the search/filter but change the mode to 'group_by'
    params_authors = {
        "search": combined_search,
        "filter": "topics.id:T11168",
        "group_by": "authorships.author.id", # <--- Aggregates results by author
        "mailto": "email@email.com"
    }

    st.caption(f"Searching for papers about `{query}` related to `{selected_principle}`...")

    with st.spinner("Analyzing literature and authors..."):
        try:
            # --- Call 1: Get Top Authors ---
            response_authors = requests.get(url, params=params_authors)
            top_authors_data = []
            
            if response_authors.status_code == 200:
                author_groups = response_authors.json().get('group_by', [])
                # Take top 10 and format for the table
                for group in author_groups[:10]:
                    top_authors_data.append({
                        "Author Name": group['key_display_name'],
                        "Works Count": group['count'],
                        "OpenAlex ID": group['key'] # Hidden metadata if needed
                    })
            
            # --- Call 2: Get Papers ---
            response_works = requests.get(url, params=params_works)
            
            # --- RENDER UI ---
            
            # A. Display Author Table First
            if top_authors_data:
                st.subheader("🏆 Top 10 Authors for this Query")
                df = pd.DataFrame(top_authors_data)
                # Display as a clean table, hiding the internal ID index
                st.dataframe(
                    df[["Author Name", "Works Count"]], 
                    use_container_width=True,
                    hide_index=True
                )
                st.markdown("---") # Separator

            # B. Display Search Results
            if response_works.status_code == 200:
                data = response_works.json()
                results = data.get('results', [])
                
                if not results:
                    st.warning("No papers found matching these criteria.")
                else:
                    st.subheader(f"📚 Top Papers (Found {data['meta']['count']})")
                    
                    for work in results:
                        # Data Extraction
                        title = work.get('title') or "Untitled"
                        publication_year = work.get('publication_year')
                        cited_by = work.get('cited_by_count')
                        doi = work.get('doi')
                        landing_page = work.get('landing_page_url')
                        link = doi if doi else landing_page
                        
                        authorships = work.get('authorships', [])
                        author_names = [a['author']['display_name'] for a in authorships]
                        if len(author_names) > 3:
                            author_str = ", ".join(author_names[:3]) + " et al."
                        else:
                            author_str = ", ".join(author_names)

                        # UI Layout
                        with st.container():
                            if link:
                                st.markdown(f"##### [{title}]({link})")
                            else:
                                st.markdown(f"##### {title}")
                            
                            c1, c2, c3 = st.columns([2, 1, 1])
                            with c1: st.caption(f"✍️ {author_str}")
                            with c2: st.caption(f"📅 {publication_year}")
                            with c3: st.markdown(f"**⭐ Citations: {cited_by}**")
                            
                            # Abstract
                            abstract_raw = work.get('abstract_inverted_index')
                            abstract_text = reconstruct_abstract(abstract_raw)
                            if abstract_text:
                                st.markdown(f"<small>{abstract_text}</small>", unsafe_allow_html=True)
                            else:
                                st.caption("*No abstract available.*")
                            st.divider()
            else:
                st.error(f"Error fetching works: {response_works.status_code}")

        except Exception as e:
            st.error(f"Connection failed: {e}")